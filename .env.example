# GAMMA-UNWIND settings. Copy this file to .env (Start GAMMA.cmd / setup.sh do it) and fill it in.
# Keep .env private: it holds your Telegram bot token and your broker keys.
# Write values right after '=', with no quotes and no spaces.

# ---- 1. Telegram (required) ----
# required: from @BotFather
TELEGRAM_BOT_TOKEN=
# required: your STANDARD group, e.g. -4987654321
TELEGRAM_GROUP_ID=
# optional: token / system messages to you only
TELEGRAM_PERSONAL_CHAT_ID=

# ---- 2. Your broker: dhan | zerodha | angel | fyers | upstox | nuvama | kotak | groww | shoonya | flattrade | definedge ----
BROKER=

# Storage security: 1 enforces strict NTFS ACLs via icacls.exe, silencing insecure principal audit warnings
GAMMA_ENFORCE_ACLS=1

# ---- 3. Fill ONLY the block of the broker named above. Leave the other blocks empty. ----
# Daily access tokens: paste here, or on the dashboard Broker login page (the program checks a token
# before saving it). The program never logs in to your broker account by itself.

# == dhan: Dhan ==
# DHAN_CLIENT_ID: Dhan client id (web.dhan.co profile)
DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN: access token (web.dhan.co > DhanHQ APIs), 24 h
DHAN_ACCESS_TOKEN=

# == zerodha: Zerodha (Kite)  [BETA - not verified live by us; run Check Setup before your first market day] ==
# KITE_API_KEY: Kite Connect app api_key (developers.kite.trade)
KITE_API_KEY=
# KITE_API_SECRET: app api_secret: only to exchange the pasted redirect URL / request_token
KITE_API_SECRET=
# KITE_ACCESS_TOKEN: access token (paste, or paste the redirect URL on the Broker login page); expires 06:00 IST
KITE_ACCESS_TOKEN=

# == angel: Angel One  [BETA - not verified live by us; run Check Setup before your first market day] ==
# ANGEL_API_KEY: SmartAPI app key (smartapi.angelone.in > My apps)
ANGEL_API_KEY=
# ANGEL_CLIENT_CODE: Angel One client code (your login id)
ANGEL_CLIENT_CODE=
# ANGEL_ACCESS_TOKEN: the day's access token (JWT); the login on the Broker login page writes it
ANGEL_ACCESS_TOKEN=
# ANGEL_FEED_TOKEN: the day's live-feed token; written by the same login, the feed needs it
ANGEL_FEED_TOKEN=

# == fyers: Fyers  [BETA - not verified live by us; run Check Setup before your first market day] ==
# FYERS_APP_ID: Fyers App ID from myapi.fyers.in (XXXXXXXXXX-200; an app made before 1 Apr 2026 works for data only)
FYERS_APP_ID=
# FYERS_SECRET_KEY: Fyers app secret: needed to turn the pasted login URL into a token
FYERS_SECRET_KEY=
# FYERS_ACCESS_TOKEN: access token (paste it, or paste the redirect URL on the Broker login page); daily
FYERS_ACCESS_TOKEN=
# FYERS_REDIRECT_URI: https://trade.fyers.in/api-login/redirect-uri/index.html = the Redirect URL to register on your Fyers app (FYERS's own page; it lets the Broker login page open the login link)
FYERS_REDIRECT_URI=

# == upstox: Upstox  [BETA - not verified live by us; run Check Setup before your first market day] ==
# UPSTOX_API_KEY: app API key (client_id): only for the redirect-URL login
UPSTOX_API_KEY=
# UPSTOX_API_SECRET: app API secret: only for the redirect-URL login
UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI: the app's registered redirect URL: only when pasting a bare code
UPSTOX_REDIRECT_URI=
# UPSTOX_ACCESS_TOKEN: daily access token (until 03:30 IST) OR your 1-year Analytics token
UPSTOX_ACCESS_TOKEN=

# == nuvama: Nuvama  [BETA - not verified live by us; run Check Setup before your first market day] ==
# NUVAMA_API_KEY: API key from Nuvama API Connect (a public app id: it rides in the login page URL, like Kite api_key)
NUVAMA_API_KEY=
# NUVAMA_API_SECRET: API secret from Nuvama; used once per login
NUVAMA_API_SECRET=
# NUVAMA_ACCESS_TOKEN: session, written by the Broker login page after you paste the redirect URL (not typed by hand)
NUVAMA_ACCESS_TOKEN=
# NUVAMA_STATIC_IP: the static public IP you registered with Nuvama (mandatory since API Connect 2.0.11): run the app on that connection, Nuvama refuses calls from any other IP
NUVAMA_STATIC_IP=

# == kotak: Kotak Neo  [BETA - not verified live by us; run Check Setup before your first market day] ==
# KOTAK_CONSUMER_KEY: access token from More > TradeAPI > API Dashboard (Kotak Neo)
KOTAK_CONSUMER_KEY=
# KOTAK_UCC: Kotak unique client code (UCC)
KOTAK_UCC=
# KOTAK_ACCESS_TOKEN: the day's session id; the login on the Broker login page writes it
KOTAK_ACCESS_TOKEN=
# KOTAK_BASE_URL: written by the login (per-account API base)
KOTAK_BASE_URL=
# KOTAK_FEED_URL: written by the login (live-feed URL)
KOTAK_FEED_URL=
# KOTAK_MOBILE: registered mobile number (+91...), needed to log in
KOTAK_MOBILE=

# == groww: Groww  [BETA - not verified live by us; run Check Setup before your first market day] ==
# GROWW_API_KEY: Groww Cloud 'TOTP token' (API key); needed to log in with today's authenticator code
GROWW_API_KEY=
# GROWW_ACCESS_TOKEN: access token (paste it, or log in with the authenticator code on the Broker login page)
GROWW_ACCESS_TOKEN=

# == shoonya: Shoonya  [BETA - not verified live by us; run Check Setup before your first market day] ==
SHOONYA_USER_ID=
# SHOONYA_ACCESS_TOKEN: Paste session token; no auto-login
SHOONYA_ACCESS_TOKEN=

# == flattrade: Flattrade  [BETA - not verified live by us; run Check Setup before your first market day] ==
FLATTRADE_USER_ID=
# FLATTRADE_ACCESS_TOKEN: Paste session token; no auto-login
FLATTRADE_ACCESS_TOKEN=

# == definedge: Definedge  [BETA - history provider & limits/quotes; live scanner blocked in Stage 1] ==
# DEFINEDGE_API_SESSION_KEY: Daily API session key (paste in .env; raw Authorization header)
DEFINEDGE_API_SESSION_KEY=
# DEFINEDGE_API_TOKEN=
# DEFINEDGE_API_SECRET=

# ---- Optional history provider & FYERS preflight tuning (Phase 1 / R1.9) ----
# GAMMA_HISTORY_PROVIDER=definedge
# GAMMA_HISTORY_BARS_LIMIT=2000
# FYERS_HISTORY_TIER=standard
